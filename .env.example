# Copy this file to .env. Never commit .env or paste credentials into chat.
META_ACCESS_TOKEN=replace_with_your_system_user_access_token
META_APP_SECRET=replace_with_your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=replace_with_a_random_secret_you_generate
# This is Meta's numeric Phone Number ID, NOT 60124182788 or your WABA ID.
WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
# Test mode checks Meta's sender against this virtual test number before any reply.
WHATSAPP_EXPECTED_NUMBER=replace_with_meta_virtual_test_number_digits_only
WHATSAPP_SENDER_MODE=test
# Optional: enables read-only WABA webhook subscription diagnostics.
META_APP_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Optional: paste your ngrok authtoken locally; the launcher reads it without printing it.
NGROK_AUTHTOKEN=
# Pinned API version; change deliberately after checking Meta's changelog.
META_GRAPH_VERSION=v25.0
DATABASE_PATH=data/vin.sqlite3
